# Copy to apps/api/.env. Everything is optional for local development:
# without Battle.net credentials the API uses dev login, mock character data,
# and an embedded Postgres (PGlite) in apps/api/.data.

# Battle.net API client (https://develop.battle.net/)
# BNET_CLIENT_ID=your_client_id
# BNET_CLIENT_SECRET=your_client_secret
# BNET_REDIRECT_URI=http://localhost:5173/auth/callback
BNET_REGION=eu

# Postgres. Leave unset to use embedded PGlite locally.
# DATABASE_URL=postgres://user:pass@localhost:5432/tavern_tracker

SESSION_SECRET=change_me_to_a_long_random_string

# Optional overrides
# DEV_LOGIN=true            # allow sign-in without Battle.net (default: on when no BNET credentials, never in production)
# BLIZZARD_MOCK=true        # fake character data (default: on when no BNET credentials, never in production)
# REFRESH_INTERVAL_MINUTES=30
# PORT=8787
